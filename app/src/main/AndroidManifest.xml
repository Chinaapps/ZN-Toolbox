<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:name=".TwoyiApplication"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twoyi" >
        <activity
            android:name="cn.zntoolbox.ui.zn.ZNToolboxHomeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Twoyi.ZN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="cn.zntoolbox.ui.zn.RootXposedActivity"
            android:label="@string/zn_root_xposed"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Twoyi.ZN" />
        <activity
            android:name="cn.zntoolbox.ui.zn.AboutActivity"
            android:label="@string/zn_about"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Twoyi.ZN" />
        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:screenOrientation="portrait"
            android:exported="true">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity>
        <activity android:name=".Render2Activity"
            android:theme="@style/Theme.Twoyi.FullScreen"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden"
            android:exported="false">
        </activity>
        <activity android:name=".RemoteRenderActivity"
            android:theme="@style/Theme.Twoyi.FullScreen"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden"
            android:exported="false">
        </activity>
        <activity android:name=".ScrcpyRenderActivity"
            android:theme="@style/Theme.Twoyi.FullScreen"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.AboutActivity"
            android:label="@string/about_btn"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.SelectAppActivity"
            android:label="@string/create_app_activity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ServerConsoleActivity"
            android:label="@string/settings_key_server_console"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.ProfileListActivity"
            android:label="@string/profile_management_title"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.ProfileEditActivity"
            android:label="@string/edit_profile"
            android:screenOrientation="portrait"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        <provider
            android:name=".provider.TwoyiDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
